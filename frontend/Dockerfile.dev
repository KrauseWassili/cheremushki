# syntax=docker/dockerfile:1

# Nur für die lokale Entwicklung: startet "next dev" mit Hot Reload gegen den
# per Bind-Mount eingehängten Quellcode. Nicht für Produktion verwenden,
# dafür ist das mehrstufige Dockerfile im selben Verzeichnis gedacht.
FROM node:22.15.1-alpine3.21

WORKDIR /frontend

COPY package.json package-lock.json ./
RUN npm install --legacy-peer-deps

COPY . .

# Datei-Watcher (inotify) funktionieren bei Bind-Mounts in Docker/Alpine oft
# nicht zuverlässig – Polling erzwingen, damit Hot Reload sicher greift.
ENV CHOKIDAR_USEPOLLING=true \
    WATCHPACK_POLLING=true

EXPOSE 3000

CMD ["npm", "run", "dev"]
