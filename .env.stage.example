# ============================================================================
# Referenzwerte für den Stage-Deploy auf stage.softeis.dev
# ============================================================================
# Diese Datei wird von der App NICHT direkt gelesen (weder Django noch
# Next.js kennen ".env.stage.example" als Dateinamen). Sie ist eine Vorlage
# für den Menschen, der den Server einrichtet: auf dem Server nach ".env" im
# Repo-Root kopieren und die TODO_SET_ME-Platzhalter durch echte Secrets
# ersetzen. ".env" ist gitignored und wird nie committet.
#
#   cp .env.stage.example .env
#   $EDITOR .env
#
# Alle Variablen, die hier nicht domain-spezifisch sind (DB, Secrets, E-Mail),
# stehen als Platzhalter da – hier werden keine Fantasie-Secrets erfunden.
# Basis ist die generische .env.example; die Kommentare dort gelten weiter,
# hier stehen nur die Werte, die sich für diesen Deploy konkret ändern.
# ============================================================================

# --- Django -------------------------------------------------------------- #
SECRET_KEY=TODO_SET_ME
DEBUG=False
ALLOWED_HOSTS=stage.softeis.dev

DJANGO_STATIC_ROOT=staticfiles
DJANGO_MEDIA_ROOT=media
DJANGO_LOG_LEVEL=INFO

# Ein vertrauenswürdiger Proxy: der geteilte Nginx (stock_nginx) auf dem Host.
DJANGO_NUM_PROXIES=1

# --- Postgres ------------------------------------------------------------ #
DATABASE_USER=TODO_SET_ME
DATABASE_PASSWORD=TODO_SET_ME
DATABASE_NAME=TODO_SET_ME
DATABASE_HOST=db
DATABASE_PORT=5432

# --- Redis: Cache und Celery --------------------------------------------- #
REDIS_URL=redis://redis:6379/0
DJANGO_CACHE_URL=

DJANGO_CELERY_BROKER_URL=redis://redis:6379/1
DJANGO_CELERY_RESULT_BACKEND=redis://redis:6379/2
DJANGO_CELERY_TASK_ALWAYS_EAGER=False

# --- Frontend und CORS --------------------------------------------------- #
CORS_ALLOWED_ORIGINS=https://stage.softeis.dev
CSRF_TRUSTED_ORIGINS=https://stage.softeis.dev
FRONTEND_URL=https://stage.softeis.dev
API_DOCS_ENABLED=True

# Zur Next.js-Build-Zeit ins Bundle eingebrannt (Browser-seitig) – müssen bei
# jeder Änderung einen Rebuild des frontend-Images auslösen (--build).
NEXT_PUBLIC_API_URL=https://stage.softeis.dev
NEXT_PUBLIC_SITE_URL=https://stage.softeis.dev

# Container-zu-Container, unverändert: 'backend' ist der Servicename im
# Docker-Netz von cheremushki, nicht der host-seitig neu gemappte Port 8010.
API_BASE_URL_INTERNAL=http://backend:8000

# --- E-Mail -------------------------------------------------------------- #
# Werden von backend/config/settings.py aktuell nur bei DEBUG=True ausgewertet
# (siehe "if DEBUG:"-Block dort) – bei DEBUG=False bleiben EMAIL_HOST/PORT/etc
# auf Djangos SMTP-Default (localhost:25, kein Login). Für echten Mailversand
# in Produktion (Passwort-Reset, E-Mail-Änderung) muss das separat ergänzt
# werden; hier trotzdem als Platzhalter gepflegt, falls/sobald das nachgezogen
# wird.
DEFAULT_FROM_EMAIL=TODO_SET_ME
EMAIL_HOST=TODO_SET_ME
EMAIL_PORT=TODO_SET_ME

# --- Telegram Bot -------------------------------------------------------- #
TELEGRAM_BOT_TOKEN=TODO_SET_ME
TELEGRAM_CHAT_ID=TODO_SET_ME

# Erzeugen mit: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=TODO_SET_ME

# Produktion mit öffentlich erreichbarem https: 'webhook'. Registrieren mit
#   manage.py set_telegram_webhook --url https://stage.softeis.dev/api/v1/bot/telegram/webhook/
TELEGRAM_UPDATE_MODE=webhook
TELEGRAM_POLL_INTERVAL_SECONDS=10

TELEGRAM_PEOPLE_TOPIC_NAME=Наши люди
TELEGRAM_PEOPLE_TOPIC_ID=TODO_SET_ME
TELEGRAM_PROFILE_URL_BASE=https://stage.softeis.dev
