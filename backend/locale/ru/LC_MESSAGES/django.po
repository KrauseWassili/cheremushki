# Projektkatalog: duzt ("ты") statt der förmlichen Upstream-Übersetzungen von
# Django, DRF und SimpleJWT ("Убедитесь, что …").
#
# LOCALE_PATHS hat Vorrang vor den Katalogen der Apps und von Django selbst –
# jede msgid hier überschreibt die gleichlautende upstream. Die msgids müssen
# deshalb Zeichen für Zeichen den Quelltexten entsprechen (inkl. typografischer
# Apostrophe wie in "can’t").
#
# Nach Änderungen neu kompilieren und django.mo mit committen (das Image hat
# kein gettext):
#   cd backend && django-admin compilemessages -l ru --ignore=.venv
#
# Der Admin ist davon nicht betroffen: Er läuft auf Deutsch
# (config.middleware.admin_language_middleware), dieser Katalog gilt nur für ru.

msgid ""
msgstr "Project-Id-Version: cheremushki\nLanguage: ru\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\nPlural-Forms: nplurals=4; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<12 || n%100>14) ? 1 : n%10==0 || (n%10>=5 && n%10<=9) || (n%100>=11 && n%100<=14)? 2 : 3);\n"

