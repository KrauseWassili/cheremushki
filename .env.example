# --- Django -------------------------------------------------------------- #
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

DJANGO_STATIC_ROOT=staticfiles
DJANGO_MEDIA_ROOT=media
DJANGO_LOG_LEVEL=INFO

# Anzahl vertrauenswürdiger Proxys vor der App. 0 = REMOTE_ADDR benutzen
# (lokal), hinter Nginx auf 1 setzen. Ohne den Wert teilen sich hinter einem
# Proxy alle Mitglieder ein gemeinsames Rate-Limit.
DJANGO_NUM_PROXIES=0

# --- Postgres ------------------------------------------------------------ #
# Alle fünf ohne Default. Host: 'db' im Compose-Netz, 'localhost' vom Host aus.
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
DATABASE_HOST=db
DATABASE_PORT=5432

# --- Redis: Cache und Celery --------------------------------------------- #
# Web-Prozess und Celery-Worker MÜSSEN dieselbe Cache-Datenbank nutzen. Daran
# hängen vier Dinge, von denen drei bei einem prozesslokalen Cache still
# aussetzen: Rate-Limits, der Lock gegen doppelte Telegram-Profilposts, der
# getUpdates-Offset und die Forum-Topic-IDs.
#
# Mit DEBUG=False ist ein fehlender Wert ein Startfehler, nicht eine Warnung.
# manage.py check --deploy prüft zusätzlich, ob der Cache erreichbar ist.
REDIS_URL=redis://redis:6379/0
# Optional; überschreibt REDIS_URL nur für den Cache.
DJANGO_CACHE_URL=

# Getrennte Datenbanknummern: Ein FLUSHDB für den Cache soll nicht die
# Warteschlange mitnehmen. Beide ohne Default, ohne sie startet nichts.
DJANGO_CELERY_BROKER_URL=redis://redis:6379/1
DJANGO_CELERY_RESULT_BACKEND=redis://redis:6379/2
# Tasks synchron im aufrufenden Prozess ausführen (nur zur Fehlersuche).
DJANGO_CELERY_TASK_ALWAYS_EAGER=False

# --- Frontend und CORS --------------------------------------------------- #
CORS_ALLOWED_ORIGINS=
FRONTEND_URL=http://localhost:3000
API_DOCS_ENABLED=True

# --- E-Mail -------------------------------------------------------------- #
DEFAULT_FROM_EMAIL=noreply@cheremushki.de
# Nur bei DEBUG=True ausgewertet; lokal übernimmt mailcatcher.
EMAIL_HOST=mailcatcher
EMAIL_PORT=1025

# --- Telegram Bot -------------------------------------------------------- #
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ohne Default. Ein leerer Wert lehnt jede Webhook Anfrage ab, der Endpunkt
# ist dann funktionslos, nicht offen. Erzeugen mit:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# 'webhook' (Produktion) oder 'polling' (lokal ohne öffentlich erreichbares
# https). Niemals beides: Telegram lehnt getUpdates bei aktivem Webhook mit
# 409 ab. Registriert wird der Webhook mit
#   manage.py set_telegram_webhook --url https://...
TELEGRAM_UPDATE_MODE=polling
TELEGRAM_POLL_INTERVAL_SECONDS=10

TELEGRAM_PEOPLE_TOPIC_NAME=Наши люди
# Fallback, falls das Topic nicht dynamisch erkannt wird. Akzeptiert '3' oder
# das t.me/c-Format '4378956431/3'.
TELEGRAM_PEOPLE_TOPIC_ID=
# https-Ersatz für die Profil-Buttons, solange FRONTEND_URL kein https ist –
# Telegram lehnt http- und localhost-URLs in Buttons ab.
TELEGRAM_PROFILE_URL_BASE=https://example.com
